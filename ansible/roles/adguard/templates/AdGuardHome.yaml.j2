# ============================================================================
# ADGUARD HOME CONFIGURATION
# ============================================================================
# Configuration générée automatiquement par Ansible
# Template: ansible/roles/adguard/templates/AdGuardHome.yaml.j2

http:
  pprof:
    port: 6060
    enabled: false
  address: {{ adguard_bind_host }}:{{ adguard_bind_port }}
  session_ttl: 720h

users:
  - name: {{ adguard_username }}
    password: {{ adguard_password_hash }}

auth_attempts: 5
block_auth_min: 15

http_proxy: ""
language: fr
theme: auto

dns:
  bind_hosts:
    - {{ adguard_bind_host }}
  port: 53

  # DNS upstream servers
  upstream_dns:
    - https://dns.cloudflare.com/dns-query
    - 1.1.1.1
    - {{ adguard_opnsense_dns }}  # OPNsense Unbound pour résolution .lan

  upstream_dns_file: ""
  bootstrap_dns:
    - 1.1.1.1
    - 1.0.0.1

  all_servers: false
  fastest_addr: false
  fastest_timeout: 1s
  allowed_clients: []
  disallowed_clients: []
  blocked_hosts:
    - version.bind
    - id.server
    - hostname.bind

  trusted_proxies:
    - 127.0.0.0/8
    - ::1/128

  cache_size: 4194304
  cache_ttl_min: 0
  cache_ttl_max: 0
  cache_optimistic: false

  bogus_nxdomain: []
  aaaa_disabled: false
  enable_dnssec: false
  edns_client_subnet:
    custom_ip: ""
    enabled: false
    use_custom: false
  max_goroutines: 300
  handle_ddr: true
  ipset: []
  ipset_file: ""

  filtering_enabled: true
  filters_update_interval: 24
  parental_enabled: false
  safesearch_enabled: false
  safebrowsing_enabled: false
  safebrowsing_cache_size: 1048576
  safesearch_cache_size: 1048576
  parental_cache_size: 1048576
  cache_time: 30

  rewrites: []
  blocked_services: []
  upstream_timeout: 10s
  private_networks: []
  use_private_ptr_resolvers: true
  local_ptr_upstreams: []

  serve_http3: false
  use_http3_upstreams: false

tls:
  enabled: false
  server_name: ""
  force_https: false
  port_https: 443
  port_dns_over_tls: 853
  port_dns_over_quic: 784
  port_dnscrypt: 0
  dnscrypt_config_file: ""
  allow_unencrypted_doh: false
  certificate_chain: ""
  private_key: ""
  certificate_path: ""
  private_key_path: ""
  strict_sni_check: false

filters:
  # Blocage publicitaire
  - enabled: true
    url: https://adguardteam.github.io/AdGuardSDNSFilter/Filters/filter.txt
    name: AdGuard DNS filter
    id: 1
  - enabled: true
    url: https://adaway.org/hosts.txt
    name: AdAway Default Blocklist
    id: 2
  - enabled: true
    url: https://easylist.to/easylist/easylist.txt
    name: EasyList
    id: 3
  - enabled: true
    url: https://easylist.to/easylist/easyprivacy.txt
    name: EasyPrivacy
    id: 4
  - enabled: true
    url: https://easylist.to/easylist/fanboy-annoyance.txt
    name: Fanboy Annoyances
    id: 5

  # Protection avancée
  - enabled: true
    url: https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts
    name: Steven Black Unified Hosts
    id: 6
  - enabled: true
    url: https://urlhaus.abuse.ch/downloads/hostfile/
    name: URLhaus Malware
    id: 7
  - enabled: true
    url: https://phishing.army/download/phishing_army_blocklist_extended.txt
    name: Phishing Army
    id: 8

  # France
  - enabled: true
    url: https://easylist.to/easylist/liste_fr.txt
    name: EasyList French
    id: 9

  # Contenu adulte (désactivé par défaut, activé par groupe)
  - enabled: false
    url: https://raw.githubusercontent.com/hagezi/dns-blocklists/main/wildcard/pro.txt
    name: Hagezi Pro - Adult Content
    id: 10

  # Réseaux sociaux (désactivé par défaut, activé par groupe)
  - enabled: false
    url: https://raw.githubusercontent.com/hagezi/dns-blocklists/main/wildcard/native.tiktok.txt
    name: Block TikTok
    id: 11
  - enabled: false
    url: https://raw.githubusercontent.com/hagezi/dns-blocklists/main/wildcard/native.instagram.txt
    name: Block Instagram
    id: 12
  - enabled: false
    url: https://raw.githubusercontent.com/hagezi/dns-blocklists/main/wildcard/native.facebook.txt
    name: Block Facebook
    id: 13

whitelist_filters: []

user_rules: []

dhcp:
  enabled: false
  interface_name: ""
  local_domain_name: lan
  dhcpv4:
    gateway_ip: ""
    subnet_mask: ""
    range_start: ""
    range_end: ""
    lease_duration: 86400
    icmp_timeout_msec: 1000
    options: []
  dhcpv6:
    range_start: ""
    lease_duration: 86400
    ra_slaac_only: false
    ra_allow_slaac: false

clients:
  runtime_sources:
    whois: true
    arp: true
    rdns: true
    dhcp: true
    hosts: true
  persistent:
    # WiFi-Admin (192.168.2.0/24) - Filtrage léger
    - name: WiFi-Admin
      tags: []
      ids:
        - 192.168.2.0/24
      use_global_settings: false
      filtering_enabled: true
      parental_enabled: false
      safebrowsing_enabled: true
      safesearch:
        enabled: false
      use_global_blocked_services: true
      blocked_services:
        schedule:
          time_zone: Europe/Paris
      upstreams: []

    # WiFi-Home (192.168.3.0/24) - Filtrage famille (adulte)
    - name: WiFi-Home
      tags: []
      ids:
        - 192.168.3.0/24
      use_global_settings: false
      filtering_enabled: true
      parental_enabled: true
      safebrowsing_enabled: true
      safesearch:
        enabled: true
      use_global_blocked_services: false
      blocked_services:
        schedule:
          time_zone: Europe/Paris
      upstreams: []

    # WiFi-IoT (192.168.4.0/24) - Filtrage minimal
    - name: WiFi-IoT
      tags: []
      ids:
        - 192.168.4.0/24
      use_global_settings: false
      filtering_enabled: true
      parental_enabled: false
      safebrowsing_enabled: true
      safesearch:
        enabled: false
      use_global_blocked_services: true
      blocked_services:
        schedule:
          time_zone: Europe/Paris
      upstreams: []

    # WiFi-Enfants (192.168.5.0/24) - Filtrage strict
    - name: WiFi-Enfants
      tags: []
      ids:
        - 192.168.5.0/24
      use_global_settings: false
      filtering_enabled: true
      parental_enabled: true
      safebrowsing_enabled: true
      safesearch:
        enabled: true
      use_global_blocked_services: false
      blocked_services:
        ids:
          - tiktok
          - instagram
          - facebook
          - snapchat
          - twitter
          - youtube
        schedule:
          time_zone: Europe/Paris
          sun:
            start: 0h0m
            end: 23h59m
          mon:
            start: 0h0m
            end: 23h59m
          tue:
            start: 0h0m
            end: 23h59m
          wed:
            start: 0h0m
            end: 23h59m
          thu:
            start: 0h0m
            end: 23h59m
          fri:
            start: 0h0m
            end: 23h59m
          sat:
            start: 0h0m
            end: 23h59m
      upstreams: []

log_compress: false
log_localtime: false
log_max_backups: 0
log_max_size: 100
log_max_age: 3
log_file: ""
verbose: false

os:
  group: ""
  user: ""
  rlimit_nofile: 0

schema_version: 27
