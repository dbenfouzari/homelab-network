# ============================================================================
# SECRETS ET VARIABLES D'ENVIRONNEMENT
# ============================================================================
# Copier ce fichier vers .env et remplir avec vos valeurs
#
# Usage:
#   cp .env.example .env
#   vim .env
#
# Ce fichier est utilisé par :
#   - Terraform (via conversion dans le Makefile)
#   - Ansible (directement)

# ============================================================================
# PROXMOX NODES - Mots de passe root
# ============================================================================
PVE_HOST_1_PASSWORD="votre_mot_de_passe_node_1"
PVE_HOST_2_PASSWORD="votre_mot_de_passe_node_2"
PVE_HOST_3_PASSWORD="votre_mot_de_passe_node_3"

# ============================================================================
# ANSIBLE - Configuration SSH
# ============================================================================
# Si vous préférez utiliser des clés SSH au lieu des mots de passe,
# commentez les variables ci-dessus et configurez vos clés SSH
