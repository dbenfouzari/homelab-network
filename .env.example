# ============================================================================
# SECRETS ET VARIABLES D'ENVIRONNEMENT
# ============================================================================
# Copier ce fichier vers .env et remplir avec vos valeurs
#
# Usage:
#   cp .env.example .env
#   vim .env
#
# Ce fichier est utilisé par :
#   - Terraform (via conversion dans le Makefile)
#   - Ansible (directement)

# ============================================================================
# PROXMOX - API Token pour Terraform
# ============================================================================
# Token API créé dans Datacenter > Permissions > API Tokens
# Format: user@realm!tokenid=secret
# Le même token fonctionne pour tous les nodes du cluster
PVE_API_TOKEN="root@pam!terraform=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ============================================================================
# PROXMOX - Mots de passe root pour Ansible
# ============================================================================
# Utilisés par Ansible pour se connecter en SSH aux nodes
PVE_HOST_1_PASSWORD="votre_mot_de_passe_node_1"
PVE_HOST_2_PASSWORD="votre_mot_de_passe_node_2"
PVE_HOST_3_PASSWORD="votre_mot_de_passe_node_3"

# ============================================================================
# LXC - Mot de passe root pour les containers
# ============================================================================
# Mot de passe root pour les containers LXC créés par Terraform
LXC_ROOT_PASSWORD="votre_mot_de_passe_lxc"

# ============================================================================
# ADGUARD HOME - Credentials
# ============================================================================
# Credentials pour l'interface web AdGuard Home
ADGUARD_USERNAME="admin"
ADGUARD_PASSWORD="votre_mot_de_passe_adguard"

# ============================================================================
# ANSIBLE - Configuration SSH
# ============================================================================
# Si vous préférez utiliser des clés SSH au lieu des mots de passe,
# commentez les variables PVE_HOST_*_PASSWORD ci-dessus et configurez vos clés SSH
